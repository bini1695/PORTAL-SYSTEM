generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  ADMIN
  REGISTRAR
  FACULTY
  BURSAR
  STUDENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum DocumentType {
  ID_CARD
  TRANSCRIPT
  PROOF_OF_ADDRESS
  IMMUNIZATION
  FINANCIAL_AID
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DegreeLevel {
  CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

enum Term {
  FALL
  SPRING
  SUMMER
  WINTER
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  DROPPED
  COMPLETED
  FAILED
}

enum HoldType {
  FINANCIAL
  ACADEMIC
  ADMINISTRATIVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// =========================================================
// TABLES
// =========================================================

model User {
  id            String        @id @default(uuid()) @db.VarChar(36)
  email         String        @unique @db.VarChar(191)
  passwordHash  String        @db.VarChar(255)
  role          Role          @default(STUDENT)
  accountStatus AccountStatus @default(PENDING)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile   Profile?
  student   Student?
  faculty   Faculty?
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
}

model Profile {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @unique @db.VarChar(36)
  firstName   String    @db.VarChar(60)
  lastName    String    @db.VarChar(60)
  phone       String?   @db.VarChar(40)
  dateOfBirth DateTime?
  address     String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Student {
  id            String        @id @default(uuid()) @db.VarChar(36)
  userId        String        @unique @db.VarChar(36)
  studentNumber String        @unique @db.VarChar(32)
  status        AccountStatus @default(PENDING)
  program       String        @db.VarChar(120)
  degreeLevel   DegreeLevel
  admittedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  enrollments Enrollment[]
  holds       Hold[]
  invoices    Invoice[]

  @@index([userId])
  @@index([studentNumber])
  @@index([status])
}

model Faculty {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @unique @db.VarChar(36)
  employeeNo String   @unique @db.VarChar(32)
  department String   @db.VarChar(120)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections Section[]

  @@index([userId])
}

model Document {
  id         String         @id @default(uuid()) @db.VarChar(36)
  studentId  String         @db.VarChar(36)
  type       DocumentType
  url        String         @db.VarChar(500)
  status     DocumentStatus @default(PENDING)
  reviewerId String?        @db.VarChar(36)
  reviewedAt DateTime?
  note       String?        @db.VarChar(500)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Course {
  id          String      @id @default(uuid()) @db.VarChar(36)
  code        String      @unique @db.VarChar(16)
  title       String      @db.VarChar(120)
  description String?     @db.VarChar(1000)
  creditUnits Int
  degreeLevel DegreeLevel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sections          Section[]
  prerequisites     Prerequisite[] @relation("CoursePrerequisites")
  isPrerequisiteFor Prerequisite[] @relation("PrerequisiteOf")

  @@index([code])
}

model Prerequisite {
  id             String @id @default(uuid()) @db.VarChar(36)
  courseId       String @db.VarChar(36)
  prerequisiteId String @db.VarChar(36)
  minimumGrade   String @default("D") @db.VarChar(2)

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
  @@index([prerequisiteId])
}

model Section {
  id            String   @id @default(uuid()) @db.VarChar(36)
  courseId      String   @db.VarChar(36)
  instructorId  String?  @db.VarChar(36)
  term          Term
  academicYear  String   @db.VarChar(9)
  sectionCode   String   @db.VarChar(8)
  room          String?  @db.VarChar(40)
  capacity      Int
  enrolledCount Int      @default(0)
  waitlistCount Int      @default(0)
  schedule      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  Faculty?     @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@unique([courseId, term, academicYear, sectionCode])
  @@index([courseId])
  @@index([instructorId])
  @@index([term, academicYear])
}

model Enrollment {
  id         String           @id @default(uuid()) @db.VarChar(36)
  studentId  String           @db.VarChar(36)
  sectionId  String           @db.VarChar(36)
  status     EnrollmentStatus @default(ENROLLED)
  grade      String?          @db.VarChar(2)
  enrolledAt DateTime         @default(now())
  droppedAt  DateTime?
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
}

model Hold {
  id         String    @id @default(uuid()) @db.VarChar(36)
  studentId  String    @db.VarChar(36)
  type       HoldType
  reason     String    @db.VarChar(500)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([active])
}

model Invoice {
  id          String        @id @default(uuid()) @db.VarChar(36)
  studentId   String        @db.VarChar(36)
  number      String        @unique @db.VarChar(64)
  amountCents Int
  status      InvoiceStatus @default(ISSUED)
  dueDate     DateTime
  description String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([studentId])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  invoiceId     String        @db.VarChar(36)
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique @db.VarChar(80)
  method        String?       @db.VarChar(40)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @db.VarChar(36)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}